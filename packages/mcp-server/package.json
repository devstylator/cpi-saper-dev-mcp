{
  "name": "cpi-saper-dev-mcp",
  "version": "0.9.0-beta.3",
  "description": "MCP server that lets an AI agent develop SAP Cloud Integration (CPI) content on development tenants: edit iFlows locally, check, push, deploy and test",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sap",
    "cloud-integration",
    "cpi",
    "iflow",
    "btp",
    "ai-agent"
  ],
  "license": "Apache-2.0",
  "author": "Damian Kolasa (devstylator)",
  "homepage": "https://github.com/devstylator/cpi-saper-dev-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devstylator/cpi-saper-dev-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/devstylator/cpi-saper-dev-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cpi-saper-dev-mcp": "bundle/index.js"
  },
  "files": [
    "bundle",
    "catalog",
    "rules",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prepack": "node ../../scripts/bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7",
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "saxon-js": "2.7.0"
  },
  "devDependencies": {
    "@cpi-saper-dev-mcp/core": "0.9.0-beta.3"
  }
}
